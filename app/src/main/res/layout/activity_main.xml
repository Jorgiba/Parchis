<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:text="PARCHÍS"
            android:textSize="16pt" />


        <ImageView
            android:id="@+id/imagen_principal"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_below="@id/titulo"
            android:layout_centerInParent="true"
            android:scaleType="fitCenter"
            android:src="@drawable/parchis"
            android:layout_marginTop="40dp"/>

        <Button
            android:id="@+id/boton_crear_partida_invitado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/imagen_principal"
            android:layout_centerHorizontal="true"
            android:text="Iniciar partida como invitado"
            android:layout_marginTop="100dp"/>

        <Button
            android:id="@+id/boton_iniciar_sesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/boton_crear_partida_invitado"
            android:layout_centerHorizontal="true"
            android:text="Iniciar sesión" />

        <Button
            android:id="@+id/boton_registrarse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/boton_iniciar_sesion"
            android:layout_centerHorizontal="true"
            android:text="Registrarse" />

    </RelativeLayout>
</layout>