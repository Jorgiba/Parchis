<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".view.GameActivity">

    <TextView
        android:id="@+id/tvTurn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="TURNO DEL\nJUGADOR ..."
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Jugadores Info -->
    <LinearLayout
        android:id="@+id/llPlayerBlue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="80dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tvPlayer1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jugador 1"
            android:textColor="@color/black" />
        <View
            android:layout_width="30dp"
            android:layout_height="15dp"
            android:layout_marginStart="8dp"
            android:background="#2196F3" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llPlayerYellow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:layout_width="30dp"
            android:layout_height="15dp"
            android:layout_marginEnd="8dp"
            android:background="#FFEB3B" />
        <TextView
            android:id="@+id/tvPlayer2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jugador 2"
            android:textColor="@color/black" />
    </LinearLayout>

    <!-- Tablero Real -->
    <FrameLayout
        android:id="@+id/boardContainer"
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTurn">

        <ImageView
            android:id="@+id/imageViewGameBoard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/tablero"
            android:src="@drawable/parchis" />

        <!-- Aquí se añadirán las fichas programáticamente o por encima -->
    </FrameLayout>

    <LinearLayout
        android:id="@+id/llPlayerRed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/boardContainer">
        <TextView
            android:id="@+id/tvPlayer4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jugador 4"
            android:textColor="@color/black" />
        <View
            android:layout_width="30dp"
            android:layout_height="15dp"
            android:layout_marginStart="8dp"
            android:background="#F44336" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llPlayerGreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/boardContainer">
        <View
            android:layout_width="30dp"
            android:layout_height="15dp"
            android:layout_marginEnd="8dp"
            android:background="#4CAF50" />
        <TextView
            android:id="@+id/tvPlayer3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jugador 3"
            android:textColor="@color/black" />
    </LinearLayout>

    <!-- Dado Contenedor Mejorado -->
    <androidx.cardview.widget.CardView
        android:id="@+id/diceCard"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/boardContainer">

        <LinearLayout
            android:id="@+id/diceActionArea"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/blue"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvDiceNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interrogación"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lanzar_dado"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnAbandon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/rojo"
        android:text="@string/abandonar_partida"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>