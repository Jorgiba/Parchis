<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"
    tools:context=".ScoreActivity">

    <TextView
        android:id="@+id/textViewScoreTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Marcador"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#5D4037"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Marcador Rojo -->
    <LinearLayout
        android:id="@+id/layoutRed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewScoreTitle">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Rojo:"
            android:textSize="20sp"
            android:textColor="#F44336" />
        <Button
            android:id="@+id/btnMinusRed"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="-" />
        <TextView
            android:id="@+id/tvScoreRed"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btnPlusRed"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="+" />
    </LinearLayout>

    <!-- Marcador Azul -->
    <LinearLayout
        android:id="@+id/layoutBlue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutRed">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Azul:"
            android:textSize="20sp"
            android:textColor="#2196F3" />
        <Button
            android:id="@+id/btnMinusBlue"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="-" />
        <TextView
            android:id="@+id/tvScoreBlue"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btnPlusBlue"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="+" />
    </LinearLayout>

    <!-- Marcador Verde -->
    <LinearLayout
        android:id="@+id/layoutGreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutBlue">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Verde:"
            android:textSize="20sp"
            android:textColor="#4CAF50" />
        <Button
            android:id="@+id/btnMinusGreen"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="-" />
        <TextView
            android:id="@+id/tvScoreGreen"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btnPlusGreen"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="+" />
    </LinearLayout>

    <!-- Marcador Amarillo -->
    <LinearLayout
        android:id="@+id/layoutYellow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutGreen">
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Amarillo:"
            android:textSize="20sp"
            android:textColor="#FFEB3B" />
        <Button
            android:id="@+id/btnMinusYellow"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="-" />
        <TextView
            android:id="@+id/tvScoreYellow"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btnPlusYellow"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="+" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Volver"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>